# Renomeie este arquivo para .env e preencha

# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Twitch (dev.twitch.tv/console > sua aplicação)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 (console.cloud.google.com > Credenciais > Chave de API)
YOUTUBE_API_KEY=

# De quantos em quantos minutos verificar as lives
INTERVALO_MINUTOS=2

# ---- Opcional: ícones ----
# Se o servidor tiver emojis chamados "twitch" e "youtube", o bot usa eles sozinho (não precisa preencher).
# Para usar outro emoji: digite \:nome_do_emoji: no Discord, copie o código (ex.: <:twitch:123456789012345678>) e cole aqui.
EMOJI_TWITCH=
EMOJI_YOUTUBE=
# Link de imagem para o ícone do rodapé (vazio = ícone padrão de cada plataforma)
ICONE_TWITCH=
ICONE_YOUTUBE=
